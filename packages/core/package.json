{
  "name": "@sweberdev/integral",
  "version": "0.1.0",
  "description": "Signed offline license keys, plans and feature entitlements, and Polar.sh license key validation. Zero dependencies, runs in Node, browsers and edge runtimes.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/integral/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/integral.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/integral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./polar": {
      "import": {
        "types": "./dist/polar.d.ts",
        "default": "./dist/polar.js"
      },
      "require": {
        "types": "./dist/polar.d.cts",
        "default": "./dist/polar.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "license",
    "license-key",
    "licensing",
    "entitlements",
    "feature-flags",
    "paywall",
    "polar",
    "ed25519"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "bin": {
    "integral": "./dist/bin.js"
  }
}
